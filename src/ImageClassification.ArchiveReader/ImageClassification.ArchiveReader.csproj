<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The 7z native interop (P/Invoke + COM marshalling) is Windows-only by
         design: the app ships for Windows and 7z.dll is a Win32 library. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyTitle>ImageClassification.ArchiveReader</AssemblyTitle>
    <Product>ImageClassification.ArchiveReader</Product>
    <Description>CBZ/CBR archive reader using SevenZipExtractor for comic cover search</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="SevenZipExtractor" Version="1.0.17" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageClassification.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageClassification.Core\ImageClassification.Core.csproj" />
  </ItemGroup>

</Project>