<Window x:Class="ImageClassification.UI.Views.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloading Model..."
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="420">
    <StackPanel Margin="20">
        <TextBlock x:Name="StatusText" Text="Starting download..." Margin="0,0,0,8"/>
        <ProgressBar x:Name="ProgressBar" Value="0" Maximum="100" Height="4"/>
        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Right"
                Margin="0,12,0,0" Padding="12,4" IsDefault="True"/>
    </StackPanel>
</Window>
