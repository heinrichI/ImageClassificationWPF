<UserControl x:Class="ImageClassification.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImageClassification.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="600" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

            <!-- General Settings -->
            <TextBlock Text="General" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
            <TextBlock Text="ONNX Runtime Thread Count:" Margin="0,0,0,4"/>
            <TextBox Text="{Binding OnnxThreadCount, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12"/>

            <TextBlock Text="Theme:" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="150" HorizontalAlignment="Left" Margin="0,0,0,12"/>

            <CheckBox Content="Use GPU Acceleration (CUDA)" IsChecked="{Binding UseGpuAcceleration}" Margin="0,0,0,20"/>

            <!-- Model Downloads -->
            <TextBlock Text="Download Models" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
            <TextBlock Text="Download pre-trained ONNX models for classification and tagging."
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding AvailableModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="#888" Margin="0,4,0,0">
                                        <Run Text="Size: "/>
                                        <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding LocalPath, Mode=OneWay}" FontSize="10"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Downloaded" Foreground="Green" FontWeight="Bold"
                                               Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisConverter}}"/>
                                    <Button Content="Download" Padding="12,4"
                                            Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsDownloaded, Converter={StaticResource InvertBoolVisConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <Button Content="Refresh" Command="{Binding RefreshModelsCommand}" Margin="0,12,0,0" Padding="12,4"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
