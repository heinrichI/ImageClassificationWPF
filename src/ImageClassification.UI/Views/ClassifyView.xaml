<UserControl x:Class="ImageClassification.UI.Views.ClassifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImageClassification.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ClassifyViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: Config -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Classify &amp; Sort Images" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Source Directory:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSourceDirectoryCommand}" VerticalAlignment="Bottom" Padding="12,6"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Confidence Threshold:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Image Size:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ImageSize, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Timestamp Window (min):" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TimestampWindowMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Sort" Command="{Binding SortImagesCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        VerticalAlignment="Bottom" Padding="16,6" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelSortCommand}"
                        IsEnabled="{Binding IsProcessing}" VerticalAlignment="Bottom" Padding="16,6"/>
            </Grid>
        </StackPanel>

        <!-- Middle: Log + Results -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Processing log -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding ProcessingLog}"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,16,0"
                      MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Current}" Width="60"/>
                    <DataGridTextColumn Header="File" Binding="{Binding CurrentFile}" Width="*"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding PredictedClass}" Width="100"/>
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P2}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Summary + Warnings -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Summary" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="Total:" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding TotalCountText}" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Sorted:" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SortedCountText}" FontWeight="Bold" Foreground="Green" Margin="0,0,0,8"/>
                <TextBlock Text="Skipped:" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SkippedCountText}" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,8"/>
                <TextBlock Text="Conflicts Skipped:" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ConflictsSkippedText}" FontWeight="Bold" Foreground="Red" Margin="0,0,0,16"/>

                <!-- Warnings -->
                <TextBlock Text="Warnings" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"
                           Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVisConverter}}"/>
                <ItemsControl ItemsSource="{Binding Warnings}" MaxHeight="150"
                              Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVisConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF3CD" BorderBrush="#FFD700" BorderThickness="1"
                                    CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Bottom: Progress -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent}" Maximum="100" Height="4" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentFileText}" Margin="12,0,0,0" Foreground="Gray"/>
        </Grid>
    </Grid>
</UserControl>
