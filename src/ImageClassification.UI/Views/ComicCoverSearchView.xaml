<UserControl x:Class="ImageClassification.UI.Views.ComicCoverSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImageClassification.UI.ViewModels"
             xmlns:controls="clr-namespace:ImageClassification.UI.Views.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:bh="clr-namespace:ImageClassification.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ComicCoverSearchViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Inner panels: search settings (or full-height results). The VM switches
             to the results panel automatically when a search finishes with matches. -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedInnerTabIndex}">

            <!-- ────────────────────────────── Search panel ────────────────────────────── -->
            <TabItem Header="Search">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Directory selection -->
                    <GroupBox Header="1. Select comic archive directories" Grid.Row="0" Margin="0,0,0,5">
                        <GroupBox.ToolTip>
                            <TextBlock>
                                Folders to search for comic archives (CBZ / CBR / PDF).
                                <LineBreak />
                                The list is remembered between app restarts.
                                <LineBreak />
                                You can also drag folders from Windows Explorer onto this panel.
                            </TextBlock>
                        </GroupBox.ToolTip>
                        <i:Interaction.Behaviors>
                            <bh:DropDirectoriesBehavior Command="{Binding AddDirectoriesCommand}" />
                        </i:Interaction.Behaviors>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0"
                                          ItemsSource="{Binding SearchDirectories}"
                                          MaxHeight="120"
                                          Margin="0,0,5,0">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,1" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Width="24"
                                                    Margin="4,1,0,1"
                                                    ToolTip="Remove directory"
                                                    Command="{Binding DataContext.RemoveDirectoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="1"
                                    Content="Add..."
                                    Command="{Binding AddDirectoryCommand}"
                                    Padding="10,5"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </GroupBox>

                    <!-- Query input (editable combo = input box + history dropdown) and action buttons -->
                    <GroupBox Header="2. Search query" Grid.Row="1" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- IsTextSearchEnabled=FALSE: typing must not jump the selection
                                 onto a history item (that would overwrite the typed text). -->
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding PhraseHistory}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Text="{Binding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding SelectedPhrase, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0" />
                            <Button Grid.Column="1"
                                    Content="Search"
                                    Command="{Binding SearchCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                    Padding="15,5"
                                    Margin="0,0,5,0" />
                            <Button Grid.Column="2"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    IsEnabled="{Binding IsBusy}"
                                    Padding="15,5" />
                        </Grid>
                    </GroupBox>

                    <!-- Similarity threshold with tooltip -->
                    <GroupBox Header="3. Similarity threshold" Grid.Row="2" Margin="0,0,0,5">
                        <GroupBox.ToolTip>
                            <TextBlock>
                                Minimum similarity score: results below this threshold are hidden.
                                <LineBreak />
                                Values range from 0% (show all) to 100% (exact match only).
                            </TextBlock>
                        </GroupBox.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Min:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <controls:NumericUpDownControl Grid.Column="1"
                                                           Minimum="0"
                                                           Maximum="1"
                                                           Step="0.01"
                                                           Format="P0"
                                                           Value="{Binding SimilarityThreshold, Mode=TwoWay}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SimilarityThreshold, StringFormat=P0}"
                                       VerticalAlignment="Center"
                                       Width="45"
                                       TextAlignment="Center" />
                        </Grid>
                    </GroupBox>

                    <!-- Search mode -->
                    <GroupBox Header="4. Search mode" Grid.Row="3" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Mode:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SearchModes}"
                                      SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0" />
                        </Grid>
                    </GroupBox>

                    <!-- Progress bar -->
                    <Grid Grid.Row="4" Margin="0,0,0,5">
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding ProgressTotal, Mode=OneWay}"
                                     Value="{Binding ProgressCurrent, Mode=OneWay}"
                                     Height="20"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                                     IsIndeterminate="{Binding ProgressTotal, Converter={StaticResource ZeroToBoolConverter}}" />
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="ProgressCurrent"/>
                                    <Binding Path="ProgressTotal"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="5" Margin="0,0,0,5">
                        <TextBlock Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"
                                   Margin="0,0,0,5" />

                        <!-- Archive currently being processed (full path; the full value is in the tooltip) -->
                        <TextBlock Text="{Binding CurrentFile}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="Gray"
                                   ToolTip="{Binding CurrentFile}"
                                   Visibility="{Binding CurrentFile, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"
                                   Margin="0,0,0,5" />

                        <!-- Archive diagnostics collected during the search (container mismatches,
                             bulk fallbacks). Visible only while it has entries. -->
                        <GroupBox Header="Archive notes"
                                  Margin="0,0,0,2"
                                  Visibility="{Binding ArchiveNotesCount, Converter={StaticResource CountToVisConverter}}">
                            <ListBox ItemsSource="{Binding ArchiveNotes}"
                                     Height="72"
                                     FontSize="11"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="OrangeRed" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ────────────────────────────── Results panel ────────────────────────────── -->
            <TabItem Header="{Binding ResultsCountText}">
                <Grid Margin="5">
                    <!-- Results list -->
                    <ListView ItemsSource="{Binding Results}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- After results are issued the keyboard focus lands on this grid, so
                             PageDown / arrows work right away (a tile selection gives the
                             standard ListView scrolling behaviour). -->
                        <i:Interaction.Behaviors>
                            <bh:ListAutoFocusBehavior WatchedProperty="Results" />
                        </i:Interaction.Behaviors>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Virtualizing panel: only visible cells are materialized, so
                                     even tens of thousands of results stay smooth to scroll.
                                     (A plain WrapPanel would silently disable virtualization
                                     and materialize every cell at once — the old UI freeze.)
                                     SpacingMode=None keeps the classic packed WrapPanel look. -->
                                <vwp:VirtualizingWrapPanel SpacingMode="None" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ComicCoverItem}">
                                <Border BorderBrush="LightGray"
                                        BorderThickness="1"
                                        Margin="4"
                                        Padding="4"
                                        Width="180"
                                        Cursor="Hand"
                                        ToolTipService.ShowDuration="15000"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}">
                                    <!-- The tile asks for its own thumbnail the moment it becomes
                                         visible (the virtualized grid materializes only visible
                                         tiles), so the LIFO pipeline always loads what is on
                                         screen — not the top of the list. -->
                                    <i:Interaction.Behaviors>
                                        <bh:LoadThumbnailOnVisibleBehavior />
                                    </i:Interaction.Behaviors>
                                    <Border.ToolTip>
                                        <TextBlock Text="{Binding ArchivePath}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400" />
                                    </Border.ToolTip>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy path"
                                                      Command="{Binding PlacementTarget.Tag.CopyArchivePathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding ArchivePath}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.OpenComicCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      CommandParameter="{Binding ArchivePath}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Similarity score -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding SimilarityText}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SimilarityScore, Converter={StaticResource ScoreToBrushConverter}}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4" />
                                        <!-- Cover image: fixed cell height so a placeholder →
                                             real-thumbnail swap never changes the item size
                                             (no results-panel re-layout per thumbnail) -->
                                        <Image Grid.Row="1"
                                               Source="{Binding Thumbnail}"
                                               Height="240"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                        <!-- File name -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding ArchiveFileName}"
                                                   TextWrapping="WrapWithOverflow"
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />
                                        <!-- Page label -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding PageLabel}"
                                                   FontSize="10"
                                                   Foreground="Gray"
                                                   TextAlignment="Center"
                                                   Margin="0,2,0,0" />
                                        <!-- Info line: original resolution | size of the displayed page
                                             (the click hint until the pipeline reports it) -->
                                        <TextBlock Grid.Row="4"
                                                   Text="{Binding InfoText}"
                                                   FontSize="10"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Placeholder shown while the results list is empty -->
                    <TextBlock Text="No results yet — run a search to see matches here."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Visibility="{Binding HasResults, Converter={StaticResource InvertBoolVisConverter}}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar (shared by both inner panels) -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <!-- Live thumbnail pipeline status: which file is being read right now, decode
                 queue depth and the loaded total (empty while idle -> hidden). -->
            <StatusBarItem Margin="16,0,0,0">
                <TextBlock Text="{Binding ThumbnailStatus}"
                           Foreground="Gray"
                           Visibility="{Binding ThumbnailStatus, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>