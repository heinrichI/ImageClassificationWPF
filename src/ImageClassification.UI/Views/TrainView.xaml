<UserControl x:Class="ImageClassification.UI.Views.TrainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImageClassification.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TrainViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Settings Panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Training Configuration" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

                <!-- Directories -->
                <TextBlock Text="Training Directory:" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TrainingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseTrainingDirectoryCommand}" Padding="12,4"/>
                </Grid>

                <TextBlock Text="Save Model Path:" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SaveModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSavePathCommand}" Padding="12,4"/>
                </Grid>

                <!-- Architecture -->
                <TextBlock Text="Model Architecture:" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" Margin="0,0,0,8"/>

                <!-- Parameters -->
                <TextBlock Text="Image Size:" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ImageSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Batch Size:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Epochs:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Epochs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Learning Rate:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LearningRate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Weight Decay:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WeightDecay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Optimizer & Schedule -->
                <TextBlock Text="Optimizer:" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Optimizers}" SelectedItem="{Binding SelectedOptimizer}" Margin="0,0,0,8"/>

                <TextBlock Text="LR Schedule:" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding LRSchedules}" SelectedItem="{Binding SelectedLRSchedule}" Margin="0,0,0,8"/>

                <TextBlock Text="Warmup Epochs:" Margin="0,0,0,4"/>
                <TextBox Text="{Binding WarmupEpochs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <!-- Augmentation -->
                <Expander Header="Augmentation" Margin="0,8,0,4">
                    <StackPanel Margin="8,8,0,0">
                        <CheckBox Content="TrivialAugment" IsChecked="{Binding UseTrivialAugment}" Margin="0,4"/>
                        <CheckBox Content="MixUp" IsChecked="{Binding UseMixUp}" Margin="0,4"/>
                        <TextBlock Text="MixUp Alpha:" Margin="20,4,0,0"/>
                        <TextBox Text="{Binding MixUpAlpha, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,8"/>
                        <CheckBox Content="CutMix" IsChecked="{Binding UseCutMix}" Margin="0,4"/>
                        <TextBlock Text="CutMix Alpha:" Margin="20,4,0,0"/>
                        <TextBox Text="{Binding CutMixAlpha, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,8"/>
                        <TextBlock Text="Label Smoothing:" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding LabelSmoothing, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    </StackPanel>
                </Expander>

                <!-- Transfer Learning -->
                <Expander Header="Transfer Learning" Margin="0,8,0,4">
                    <StackPanel Margin="8,8,0,0">
                        <CheckBox Content="Progressive Unfreezing" IsChecked="{Binding UseProgressiveUnfreezing}" Margin="0,4"/>
                        <CheckBox Content="ImageNet-21k Weights" IsChecked="{Binding UseImageNet21kWeights}" Margin="0,4"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Training progress + chart -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding CurrentEpochText}" Margin="12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding StartTrainingCommand}"
                            IsEnabled="{Binding IsTraining, Converter={StaticResource InvertBoolConverter}}"
                            Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="Stop" Command="{Binding StopTrainingCommand}"
                            IsEnabled="{Binding IsTraining}" Padding="16,6"/>
                </StackPanel>
            </Grid>

            <!-- Training chart placeholder -->
            <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="4" Margin="0,0,0,12">
                <TextBlock Text="Training Loss/Accuracy Chart (LiveCharts)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontStyle="Italic"/>
            </Border>

            <!-- Epoch history table -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding TrainingHistory}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      MaxHeight="200" Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Epoch" Binding="{Binding Epoch}" Width="60"/>
                    <DataGridTextColumn Header="Train Loss" Binding="{Binding TrainLoss, StringFormat=F4}" Width="80"/>
                    <DataGridTextColumn Header="Train Acc" Binding="{Binding TrainAccuracy, StringFormat=P1}" Width="80"/>
                    <DataGridTextColumn Header="Val Loss" Binding="{Binding ValidationLoss, StringFormat=F4}" Width="80"/>
                    <DataGridTextColumn Header="Val Acc" Binding="{Binding ValidationAccuracy, StringFormat=P1}" Width="80"/>
                    <DataGridTextColumn Header="LR" Binding="{Binding LearningRate, StringFormat=E2}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Progress bar -->
            <ProgressBar Grid.Row="3" Value="{Binding ProgressPercent}" Maximum="100" Height="4"/>
        </Grid>
    </Grid>
</UserControl>
