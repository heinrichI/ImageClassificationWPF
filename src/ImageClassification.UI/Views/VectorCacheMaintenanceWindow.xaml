<Window x:Class="ImageClassification.UI.Views.VectorCacheMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding OperationTitle}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12" />

        <!-- Idle: the window doubles as the confirmation — nothing runs until Start is pressed -->
        <Button Content="Start"
                Command="{Binding StartCommand}"
                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisConverter}}"
                HorizontalAlignment="Left" Padding="18,4" Margin="0,0,0,4" />

        <!-- Running: progress + phase + cancel -->
        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}">
            <ProgressBar Height="14" Minimum="0"
                         Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}" />
            <TextBlock Text="{Binding PhaseText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MissingText}" Foreground="Gray" Margin="0,2,0,0" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Margin="0,10,0,0" HorizontalAlignment="Left" Padding="18,4" />
        </StackPanel>

        <!-- Finished: result + close -->
        <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" Foreground="Green" FontSize="16"
                           Visibility="{Binding ResultSuccess, Converter={StaticResource BoolToVisConverter}}" />
                <TextBlock Text="✗" Foreground="Red" FontSize="16"
                           Visibility="{Binding ResultSuccess, Converter={StaticResource InvertBoolVisConverter}}" />
            </StackPanel>
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Button Content="Close" IsDefault="True" Click="Close_Click"
                    Margin="0,12,0,0" HorizontalAlignment="Left" Padding="18,4" />
        </StackPanel>
    </StackPanel>
</Window>