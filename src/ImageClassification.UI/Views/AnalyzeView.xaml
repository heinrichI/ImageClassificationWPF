<UserControl x:Class="ImageClassification.UI.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImageClassification.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AnalyzeViewModel}"
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: Config -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Analyze Images" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

            <!-- Mode selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="Auto-Cluster" IsChecked="{Binding IsClusterMode}" Margin="0,0,16,0"
                             GroupName="AnalyzeMode"/>
                <RadioButton Content="By Tags (CLIP)" IsChecked="{Binding IsClusterMode, Converter={StaticResource InvertBoolConverter}}"
                             GroupName="AnalyzeMode"/>
            </StackPanel>

            <!-- Source Directory -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Source Directory:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSourceDirectoryCommand}" VerticalAlignment="Bottom" Padding="12,6"/>
            </Grid>

            <!-- Cluster Mode Settings -->
            <StackPanel Visibility="{Binding IsClusterMode, Converter={StaticResource BoolToVisConverter}}">
                <CheckBox Content="Auto-detect number of clusters" IsChecked="{Binding AutoDetectClusters}" Margin="0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Number of clusters:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding NumClusters, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DetectedKText}" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Tag Mode Settings -->
            <StackPanel Visibility="{Binding IsClusterMode, Converter={StaticResource InvertBoolConverter}}">
                <TextBlock Text="Candidate Tags (comma-separated):" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CandidateTags, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Top-K Tags:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TopK, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Confidence Threshold:" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TagConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Analyze" Command="{Binding AnalyzeCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Sort by Clusters" Command="{Binding SortByClustersCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Sort by Tags" Command="{Binding SortByTagsCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsProcessing}" Padding="16,6"/>
            </StackPanel>
        </StackPanel>

        <!-- Middle: Results -->
        <Grid Grid.Row="1">
            <!-- Cluster results -->
            <StackPanel Visibility="{Binding IsClusterMode, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Clusters" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Clusters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SuggestedName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontWeight="Bold" Width="200" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ImageCount, StringFormat='{}{0} images'}"
                                                   Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ImagePaths, Converter={StaticResource PathListConverter}}"
                                               Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"
                                               MaxHeight="40"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Tag results with thumbnails -->
            <ScrollViewer Visibility="{Binding IsClusterMode, Converter={StaticResource InvertBoolConverter}}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding EditableTagResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Thumbnail -->
                                    <Border Width="80" Height="80" CornerRadius="4" ClipToBounds="True" Margin="0,0,12,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <!-- Tags -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Tag}" Width="100" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ScoreText}" Foreground="Gray" Width="40" VerticalAlignment="Center"/>
                                                        <ProgressBar Value="{Binding Score}" Maximum="1" Width="100" Height="8"
                                                                     Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom: Progress -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent}" Maximum="100" Height="4" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentFileText}" Margin="12,0,0,0" Foreground="Gray"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="Gray"/>
        </Grid>
    </Grid>
</UserControl>
