<UserControl x:Class="ImageClassification.UI.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImageClassification.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AnalyzeViewModel}"
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: Config -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Analyze Images" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

            <!-- Mode selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="Auto-Cluster" IsChecked="{Binding IsClusterMode}" Margin="0,0,16,0"
                             GroupName="AnalyzeMode"
                             ToolTip="k-means clustering by visual features, no labels. You name the clusters, then Sort by Clusters."/>
                <RadioButton Content="By Tags (CLIP)" IsChecked="{Binding IsClusterMode, Converter={StaticResource InvertBoolConverter}}"
                             GroupName="AnalyzeMode"
                             ToolTip="CLIP zero-shot: every image is scored against your candidate tags. Review the checked tags, then Sort by Tags."/>
            </StackPanel>

            <!-- Source Directory -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Source Directory:" Margin="0,0,0,4"
                               ToolTip="Folder with images (jpg, jpeg, png, bmp, tiff, webp). Only the top level of the folder is scanned — subfolders are ignored."/>
                    <TextBox Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSourceDirectoryCommand}" VerticalAlignment="Bottom" Padding="12,6"
                        ToolTip="Select the folder with images"/>
            </Grid>

            <!-- Cluster Mode Settings -->
            <StackPanel Visibility="{Binding IsClusterMode, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Margin="0,0,0,6" Foreground="Gray" TextWrapping="Wrap"
                           Text="Auto-Cluster: groups images by visual similarity (k-means, no labels). The app suggests cluster names — edit them, then 'Sort by Clusters' copies images into one folder per cluster. Needs the MobileNetV2 model."/>
                <CheckBox Content="Auto-detect number of clusters" IsChecked="{Binding AutoDetectClusters}" Margin="0,4"
                          ToolTip="Let the app choose the cluster count (silhouette score)"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Number of clusters:" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Used when auto-detect is off"/>
                    <TextBox Text="{Binding NumClusters, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0" ToolTip="Used when auto-detect is off"/>
                    <TextBlock Text="{Binding DetectedKText}" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Tag Mode Settings -->
            <StackPanel Visibility="{Binding IsClusterMode, Converter={StaticResource InvertBoolConverter}}">
                <TextBlock Margin="0,0,0,6" Foreground="Gray" TextWrapping="Wrap"
                           Text="By Tags (CLIP): zero-shot, no training — every image is scored against the candidate tags below (e.g. 'autumn'). Top-K is chosen from that list only. Review the checked tags, then 'Sort by Tags' copies images into one folder per tag. Needs the CLIP ViT-B/32 model."/>
                <TextBlock Text="Candidate Tags (comma-separated):" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CandidateTags, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                         ToolTip="Tags to look for — comma-, semicolon- or line-separated. Top-K is chosen from this list only, so include every topic you care about (e.g. autumn)."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Top-K Tags:" Margin="0,0,0,4" ToolTip="How many best-matching tags to show per image"/>
                        <TextBox Text="{Binding TopK, UpdateSourceTrigger=PropertyChanged}" ToolTip="How many best-matching tags to show per image"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Confidence Threshold:" Margin="0,0,0,4" ToolTip="Tags with a score above this value are pre-checked in the results"/>
                        <TextBox Text="{Binding TagConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tags with a score above this value are pre-checked in the results"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Analyze" Command="{Binding AnalyzeCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        Padding="16,6" Margin="0,0,8,0"
                        ToolTip="Run the analysis on the images in the source folder. Nothing is written to disk — results appear in the list below."/>
                <Button Content="Sort by Clusters" Command="{Binding SortByClustersCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        Padding="16,6" Margin="0,0,8,0"
                        ToolTip="Copy every image into a subfolder named after its cluster (e.g. 'autumn'). The originals stay in the source folder. Needs an Auto-Cluster run first; subfolders are not cleaned, so stale copies may remain."/>
                <Button Content="Sort by Tags" Command="{Binding SortByTagsCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                        Padding="16,6" Margin="0,0,8,0"
                        ToolTip="Copy each image into a subfolder for every CHECKED tag (an image can go into several folders). The originals stay in the source folder. Needs a By Tags run first; subfolders are not cleaned, so stale copies may remain."/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsProcessing}" Padding="16,6"
                        ToolTip="Stop the analysis. Takes effect between images; already processed images remain in the results (By Tags mode)."/>
            </StackPanel>
        </StackPanel>

        <!-- Middle: Results -->
        <Grid Grid.Row="1">
            <!-- Cluster results -->
            <StackPanel Visibility="{Binding IsClusterMode, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Clusters" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Clusters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding SuggestedName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontWeight="Bold" Width="200" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ImageCount, StringFormat='{}{0} images'}"
                                                   Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ImagePaths, Converter={StaticResource PathListConverter}}"
                                               Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"
                                               MaxHeight="40"
                                               ToolTip="Images in this cluster (list may be clipped)"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Tag results with thumbnails -->
            <ScrollViewer Visibility="{Binding IsClusterMode, Converter={StaticResource InvertBoolConverter}}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding EditableTagResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Thumbnail -->
                                    <Border Width="80" Height="80" CornerRadius="4" ClipToBounds="True" Margin="0,0,12,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <!-- Tags -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Tag}" Width="100" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ScoreText}" Foreground="Gray" Width="40" VerticalAlignment="Center"/>
                                                        <ProgressBar Value="{Binding Score}" Maximum="1" Width="100" Height="8"
                                                                     Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom: Progress -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent}" Maximum="100" Height="4" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding CurrentFileText}" Margin="12,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
