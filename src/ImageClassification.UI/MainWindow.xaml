<Window x:Class="ImageClassification.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ImageClassification.UI.Views"
        mc:Ignorable="d"
        Title="Image Classification" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="MainTabControl" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="  Training  ">
                <views:TrainView x:Name="TrainViewControl" />
            </TabItem>
            <TabItem Header="  Evaluation  ">
                <views:EvaluateView x:Name="EvaluateViewControl" />
            </TabItem>
            <TabItem Header="  Classify &amp; Sort  ">
                <views:ClassifyView x:Name="ClassifyViewControl" />
            </TabItem>
            <TabItem Header="  Analyze  ">
                <views:AnalyzeView x:Name="AnalyzeViewControl" />
            </TabItem>
            <TabItem Header="  Settings  ">
                <views:SettingsView x:Name="SettingsViewControl" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
