<Application x:Class="ImageClassification.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ImageClassification.UI.Converters">
    <Application.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToVisConverter x:Key="BoolToVisConverter"/>
        <converters:PathListConverter x:Key="PathListConverter"/>
        <converters:InvertBoolVisConverter x:Key="InvertBoolVisConverter"/>
        <converters:CountToVisConverter x:Key="CountToVisConverter"/>
        <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter"/>
        <converters:ZeroToBoolConverter x:Key="ZeroToBoolConverter"/>
        <converters:ScoreToBrushConverter x:Key="ScoreToBrushConverter"/>
    </Application.Resources>
</Application>
