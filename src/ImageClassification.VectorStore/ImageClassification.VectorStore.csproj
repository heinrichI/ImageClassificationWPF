    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>ImageClassification.VectorStore</AssemblyTitle>
    <Product>ImageClassification.VectorStore</Product>
    <Description>SQLite-backed vector embedding cache for image features</Description>
