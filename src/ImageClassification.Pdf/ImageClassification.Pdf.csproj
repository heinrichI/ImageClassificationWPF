<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>ImageClassification.Pdf</AssemblyTitle>
    <Product>ImageClassification.Pdf</Product>
    <Description>PDF comic container handler (PdfPig) for comic cover search</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <!-- Scanned comics usually store pages as DCT (JPEG); JBIG2 and JPX cover the
         remaining compression schemes seen in professionally produced PDFs. -->
    <PackageReference Include="PdfPig.Filters.Dct.JpegLibrary" Version="0.1.12.1" />
    <PackageReference Include="PdfPig.Filters.Jbig2.PdfboxJbig2" Version="0.1.12.1" />
    <PackageReference Include="PdfPig.Filters.Jpx.OpenJpeg" Version="0.1.12.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageClassification.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" PublicKey="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageClassification.Core\ImageClassification.Core.csproj" />
  </ItemGroup>

</Project>